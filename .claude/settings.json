{
  "permissions": {
    "allow": [
      "Edit",
      "Bash(npm run *)",
      "Bash(git commit *)",
      "Bash(git * main)",
      "Bash(* --version)",
      "Bash(* --help *)",
      "Edit(/.claude/skills/sk.uat/**)",
      "Edit(/.claude/skills/sk.ff/**)",
      "Edit(/.claude/**)",
      "Edit(/.claude/skills/sk.design/**)",
      "Edit(/.claude/skills/governance/**)",
      "Edit(/.claude/skills/observability-contracts/**)",
      "Edit(/.claude/skills/observability-backend/**)",
      "Edit(/.claude/skills/observability-frontend/**)",
      "Edit(/.claude/skills/observability-infra/**)",
      "Bash(bash .claude/hooks/archive-file.sh \".claude/skills/observability-patterns/SKILL.md\" \"Split into observability-{contracts,backend,frontend,infra} on 2026-04-29 — original was approaching 1000 lines, causing context bloat for backend-only and frontend-only agents. Replaced by four focused skills with observability-contracts holding the shared seams \\(resource attrs, runtime-config JSON shape, PII deny-list, Loki label allow-list, span naming, trace propagation rules\\).\")",
      "Edit(/.claude/skills/fastendpoints-patterns/**)",
      "Edit(/.claude/skills/csharp-clean-arch/**)",
      "Read(/.claude/**)"
    ],
    "deny": [
      "Bash(rm *)",
      "Bash(rm)",
      "Bash(rmdir *)",
      "Bash(del *)",
      "Bash(unlink *)",
      "Bash(Remove-Item *)",
      "Bash(* | rm *)",
      "Bash(* && rm *)"
    ],
    "defaultMode": "acceptEdits",
    "additionalDirectories": [
      "d:\\work\\SDD Reference\\repo\\SpecKit-SSD-SDLC\\.claude\\skills"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/check-system-prompt-files.sh\""
          }
        ]
      },
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/post-skill.sh\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/post-response.sh\""
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/log-cache-metrics.sh\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/intercept-delete.sh\""
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/validate-path.sh\""
          }
        ]
      },
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/check-skill-preconditions.sh\""
          }
        ]
      }
    ]
  },
  "disableBypassPermissionsMode": "disable"
}
